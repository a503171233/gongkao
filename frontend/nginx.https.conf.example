# ============================================================
# HTTPS 版 nginx 配置（C5 P1-1）—— 由 setup-https.sh 生成使用
# 放置路径：frontend/nginx.https.conf → 镜像内 /etc/nginx/conf.d/default.conf
# 替换占位：__DOMAIN__（你的域名，如 gk.example.com）
#
# ⚠️ 硬性契约（不得回退）：
#   1. /api/ 前缀剥离规则与 nginx.conf 完全一致（proxy_pass 尾斜杠）
#   2. /api/ask SSE 300s 超时 + buffering off 保持
#   3. /api/upload 限流 3r/m 保持
# ============================================================
limit_req_zone $binary_remote_addr zone=ask_zone:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=upload_zone:10m rate=3r/m;

# HTTP → HTTPS 强制跳转（OAuth 回调等整页跳转也走 https）
server {
    listen 80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;

    # 证书（certbot 签发，经 docker-compose.https.yml 挂载进容器）
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    root /usr/share/nginx/html;
    index index.html;

    # 大课件上传（PPT/PDF 常 10-50MB）
    client_max_body_size 50m;

    # 问答（SSE 流式，禁缓冲；300s 超时——LLM 最慢实测 121s）
    location /api/ask {
        limit_req zone=ask_zone burst=10 nodelay;
        proxy_pass http://backend:9000/ask;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 上传（限频 3次/分钟）
    location /api/upload {
        limit_req zone=upload_zone burst=3;
        proxy_pass http://backend:9000/upload;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    # 其余 API
    location /api/ {
        proxy_pass http://backend:9000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    location = /admin {
        return 302 /admin.html;
    }
    location = /admin/ {
        return 302 /admin.html;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
