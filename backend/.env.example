# ===== 多老师专属垂直大模型平台 · M1 POC 配置 =====
# 复制本文件为 `.env` 并填写，或直接导出为环境变量。
# 注意：.env 含密钥，不要提交到 git。

# 大模型 API（经中转站统一出口；你已有的中转站顺手填这里）
API_BASE_URL=https://ai.anyyds.cn/v1
API_KEY=sk-请填写你的中转站key
LLM_MODEL=deepseek-chat

# Embedding：教学场景推荐 bge-m3（若中转站暴露了 embedding 模型就填它）
# EMBED_PROVIDER: api = 走中转站 /embeddings 接口；selftest = 离线哈希向量（仅自测用，勿用于真实问答）
EMBED_PROVIDER=api
EMBED_MODEL=bge-m3

# 向量库持久化目录（相对项目根）
DB_PATH=data/vector

# M1 先做一位老师（言语理解）
TEACHER_ID=T001
TEACHER_NAME=星辰老师
TEACHER_SUBJECT=言语理解

# 检索参数（对应说明书 §6.2 / §7.3）
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_N=6
SIMILARITY_THRESHOLD=0.5
TEMPERATURE=0.3

# ===== Open API v1 · 开放接口（文档管理等，/api/v1/*） =====
# 未配置密钥时开放端点一律 503（未启用）；配置后第三方以 X-API-Key 头访问
# 生成方式：python -c "import secrets; print('gk_open_' + secrets.token_hex(16))"
# OPENAPI_KEY=gk_open_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== C5 · 性能/SLO（P1-2） =====
# P95 时延阈值（ms，默认 30000）。可用性阈值（%，默认 99.0）
SLO_P95_MS=30000
SLO_AVAILABILITY=99.0
# SLO 违约 webhook（可选，空=仅日志；支持飞书钉钉企业微信机器人 webhook URL）
# SLO_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx

# ===== C5 · CSRF 安全加固（P2-5） =====
# 信任的跨域 Origin（逗号分隔，仅对状态变更请求校验；未配置=仅同源+无Origin放行）
# CSRF_ALLOWED_ORIGINS=https://gk.example.com

# ===== C5 · 视频转写（P3-7，预留阻塞中） =====
# 上游中转站暴露 whisper 通道后可启用，当前 2C/3.6G 不做本地 ASR（OOM 风险）
# WHISPER_ENABLED=1
# WHISPER_BASE_URL=https://ai.anyyds.cn/v1
# WHISPER_API_KEY=sk-xxx
# WHISPER_MODEL=whisper-1

# ===== 自动采集（默认关闭；仅在服务器 CPU 与内存使用率均低于阈值时执行） =====
# 开启需同时满足：AUTOCOLLECT_ENABLED=1 + 提供免费模型通道或复用默认 LLM。
# 关闭状态下不产生任何 LLM 调用，也不会启动后台采集线程。
# AUTOCOLLECT_ENABLED=0
# AUTOCOLLECT_INTERVAL=3600          # 后台守候间隔（秒，最小 60）
# AUTOCOLLECT_CPU_MAX=80             # CPU 使用率阈值（%）
# AUTOCOLLECT_MEM_MAX=80             # 内存使用率阈值（%）
# AUTOCOLLECT_MAX_PER_CYCLE=100      # 每轮最多新增题目数（预算上限）
# AUTOCOLLECT_TEACHERS=T001,T002     # 文档库轮询范围（逗号分隔；空=全部启用老师）
# AUTOCOLLECT_URLS=                  # 公开题库网址（逗号/换行分隔）
# AUTOCOLLECT_SEARCH_QUERIES=        # AI 联网搜索词（逗号/换行分隔）
# 免费模型通道（留空则复用「AI 模型管理」默认模型）：
# AUTOCOLLECT_MODEL=
# AUTOCOLLECT_BASE_URL=
# AUTOCOLLECT_API_KEY=

# ===== 运行时 AI 技能层（《运行时AI技能与MCP能力开发说明书》§九 P0） =====
# 题目提取 prompt 已模板化到 poc/skills/prompts/。
# SKILL_EXTRACT_ENABLED=0 紧急回退旧内联调用环（默认 1=技能路径，行为与迁移前一致）
# SKILL_EXTRACT_TEMPLATE=baseline（默认，迁移前 prompt 逐字节等价）| optimized
#   （§4.1 优化模板：正向门槛+注入防御；切换前必须过 poc/skills/selftest 比对门禁）
# SKILL_EXTRACT_ENABLED=1
# SKILL_EXTRACT_TEMPLATE=baseline

# ===== MCP 能力层（§五/§六；不配置网关=全部走内置 provider，零行为变化） =====
# 能力开关：auto（默认，有网关用 MCP+失败回退内置）| builtin | mcp | off
# CAP_SEARCH_PROVIDER=auto
# CAP_FETCH_PROVIDER=auto
# CAP_DOCPARSE_PROVIDER=builtin     # 含 OCR 的 mcp 属 P2，默认内置
# MCP 网关（Streamable HTTP；仅指向受信内网/自建网关）：
# MCP_GATEWAY_URL=
# MCP_API_KEY=
# MCP_TIMEOUT_SECONDS=60
# MCP_MAX_RETRIES=2
# 能力→MCP 工具名绑定（tools/list 可探测校验）：
# MCP_TOOL_SEARCH=
# MCP_TOOL_FETCH=
# MCP_TOOL_DOCPARSE=
# MCP_TOOL_VISION=
# MCP_TOOL_ASR=
# MCP_TOOL_RERANK=