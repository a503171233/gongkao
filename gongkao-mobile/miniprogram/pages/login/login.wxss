.wrap { padding: 120rpx 60rpx; }
.logo {
  width: 140rpx; height: 140rpx; border-radius: 32rpx; margin: 0 auto;
  background: #C9A227; color: #fff; font-size: 60rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.title { text-align: center; font-size: 40rpx; font-weight: 700; margin-top: 24rpx; }
.sub { text-align: center; font-size: 26rpx; color: #888; margin: 12rpx 0 60rpx; }
.ipt {
  background: #fff; border-radius: 16rpx; padding: 24rpx 28rpx;
  margin-bottom: 24rpx; font-size: 30rpx; border: 1rpx solid #eee;
}
.btn {
  margin-top: 24rpx; background: #C9A227; color: #fff; border-radius: 16rpx;
  font-size: 32rpx;
}
